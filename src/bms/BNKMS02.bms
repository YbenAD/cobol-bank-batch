*---------------------------------------------------------------------
* BNKMS02 : ECRAN D'HISTORIQUE DES MOUVEMENTS (TRANSACTION BNKH)
* MAPSET BNKMS02 / MAP BNKMP02 - TERMINAL 3270 24 X 80
* 10 MOUVEMENTS PAR PAGE (LIG01 A LIG10), PF7/PF8 POUR PAGINER
* DONNEES : KSDS MVTHIST (EXTRACTION DB2), PARCOURU PAR BROWSE CICS
* CTRL SANS FRSET : LE NUMERO DE COMPTE GARDE SON MDT ENTRE DEUX
* ENVOIS (LES MESSAGES SONT ENVOYES EN DATAONLY)
*---------------------------------------------------------------------
BNKMS02  DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,STORAGE=AUTO,      X
               TIOAPFX=YES,CTRL=FREEKB,MAPATTS=(COLOR,HILIGHT),        X
               DSATTS=(COLOR)
BNKMP02  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
* LIGNE 1 : TRANSACTION, TITRE, DATE DU JOUR
         DFHMDF POS=(1,2),LENGTH=4,ATTRB=(ASKIP,BRT),COLOR=YELLOW,     X
               INITIAL='BNKH'
         DFHMDF POS=(1,26),LENGTH=28,ATTRB=(ASKIP,BRT),COLOR=TURQUOISE,X
               INITIAL='HISTORIQUE DES MOUVEMENTS'
DATEJ    DFHMDF POS=(1,70),LENGTH=10,ATTRB=(ASKIP,NORM),COLOR=TURQUOISE
* LIGNES 3 ET 4 : COMPTE, PAGE, TITULAIRE
         DFHMDF POS=(3,2),LENGTH=22,ATTRB=(ASKIP,NORM),COLOR=GREEN,    X
               INITIAL='NUMERO DE COMPTE     :'
NUMCPT   DFHMDF POS=(3,26),LENGTH=11,ATTRB=(UNPROT,NUM,BRT,IC,FSET),   X
               COLOR=YELLOW,HILIGHT=UNDERLINE
         DFHMDF POS=(3,38),LENGTH=1,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(3,60),LENGTH=12,ATTRB=(ASKIP,NORM),COLOR=GREEN,   X
               INITIAL='PAGE       :'
PAGE     DFHMDF POS=(3,74),LENGTH=3,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
         DFHMDF POS=(4,2),LENGTH=22,ATTRB=(ASKIP,NORM),COLOR=GREEN,    X
               INITIAL='TITULAIRE            :'
TITU     DFHMDF POS=(4,26),LENGTH=30,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
* LIGNE 6 : EN-TETE ALIGNE SUR LA LIGNE DE DETAIL (DONNEES COL 3) :
*   DATE 10, REFERENCE 12, TYPE 1, MONTANT 14, LIBELLE 30
         DFHMDF POS=(6,2),LENGTH=27,ATTRB=(ASKIP,NORM),COLOR=TURQUOISE,X
               HILIGHT=UNDERLINE,INITIAL='DATE        REFERENCE     T'
         DFHMDF POS=(6,38),LENGTH=16,ATTRB=(ASKIP,NORM),               X
               COLOR=TURQUOISE,HILIGHT=UNDERLINE,                      X
               INITIAL='MONTANT  LIBELLE'
* LIGNES 8 A 17 : 10 MOUVEMENTS PAR PAGE
LIG01    DFHMDF POS=(8,2),LENGTH=75,ATTRB=(ASKIP,NORM),COLOR=NEUTRAL
LIG02    DFHMDF POS=(9,2),LENGTH=75,ATTRB=(ASKIP,NORM),COLOR=NEUTRAL
LIG03    DFHMDF POS=(10,2),LENGTH=75,ATTRB=(ASKIP,NORM),COLOR=NEUTRAL
LIG04    DFHMDF POS=(11,2),LENGTH=75,ATTRB=(ASKIP,NORM),COLOR=NEUTRAL
LIG05    DFHMDF POS=(12,2),LENGTH=75,ATTRB=(ASKIP,NORM),COLOR=NEUTRAL
LIG06    DFHMDF POS=(13,2),LENGTH=75,ATTRB=(ASKIP,NORM),COLOR=NEUTRAL
LIG07    DFHMDF POS=(14,2),LENGTH=75,ATTRB=(ASKIP,NORM),COLOR=NEUTRAL
LIG08    DFHMDF POS=(15,2),LENGTH=75,ATTRB=(ASKIP,NORM),COLOR=NEUTRAL
LIG09    DFHMDF POS=(16,2),LENGTH=75,ATTRB=(ASKIP,NORM),COLOR=NEUTRAL
LIG10    DFHMDF POS=(17,2),LENGTH=75,ATTRB=(ASKIP,NORM),COLOR=NEUTRAL
* LIGNE 20 : MESSAGE / LIGNE 24 : TOUCHES DE FONCTION
MSG      DFHMDF POS=(20,2),LENGTH=78,ATTRB=(ASKIP,BRT),COLOR=GREEN
         DFHMDF POS=(24,2),LENGTH=30,ATTRB=(ASKIP,NORM),COLOR=BLUE,    X
               INITIAL='ENTREE=RECHERCHER  PF3=QUITTER'
         DFHMDF POS=(24,36),LENGTH=38,ATTRB=(ASKIP,NORM),COLOR=BLUE,   X
               INITIAL='PF7=PAGE PRECEDENTE  PF8=PAGE SUIVANTE'
         DFHMSD TYPE=FINAL
         END
