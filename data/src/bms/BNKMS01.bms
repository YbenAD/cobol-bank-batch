*---------------------------------------------------------------------
* BNKMS01 : ECRAN DE CONSULTATION DE COMPTE (TRANSACTION BNKI)
* MAPSET BNKMS01 / MAP BNKMP01 - TERMINAL 3270 24 X 80
* ASSEMBLE DEUX FOIS (JCL COMPBMS) :
*   SYSPARM(MAP)   -> MAP PHYSIQUE DANS CICS.PROD.DFHLOAD
*   SYSPARM(DSECT) -> MAP SYMBOLIQUE (COPYBOOK) DANS BANK.CPY
*---------------------------------------------------------------------
BNKMS01  DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,STORAGE=AUTO,      X
               TIOAPFX=YES,CTRL=(FREEKB,FRSET),MAPATTS=(COLOR,HILIGHT),X
               DSATTS=(COLOR)
BNKMP01  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
* LIGNE 1 : TRANSACTION, TITRE, DATE DU JOUR
         DFHMDF POS=(1,2),LENGTH=4,ATTRB=(ASKIP,BRT),COLOR=YELLOW,     X
               INITIAL='BNKI'
         DFHMDF POS=(1,26),LENGTH=28,ATTRB=(ASKIP,BRT),COLOR=TURQUOISE,X
               INITIAL='CONSULTATION DE COMPTE'
DATEJ    DFHMDF POS=(1,70),LENGTH=10,ATTRB=(ASKIP,NORM),COLOR=TURQUOISE
* LIGNE 4 : SAISIE DU NUMERO DE COMPTE
         DFHMDF POS=(4,2),LENGTH=22,ATTRB=(ASKIP,NORM),COLOR=GREEN,    X
               INITIAL='NUMERO DE COMPTE     :'
NUMCPT   DFHMDF POS=(4,26),LENGTH=11,ATTRB=(UNPROT,NUM,BRT,IC,FSET),   X
               COLOR=YELLOW,HILIGHT=UNDERLINE
         DFHMDF POS=(4,38),LENGTH=1,ATTRB=(ASKIP,NORM)
* LIGNES 6 A 13 : INFORMATIONS DU COMPTE
         DFHMDF POS=(6,2),LENGTH=22,ATTRB=(ASKIP,NORM),COLOR=GREEN,    X
               INITIAL='TITULAIRE            :'
TITU     DFHMDF POS=(6,26),LENGTH=30,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
         DFHMDF POS=(8,2),LENGTH=22,ATTRB=(ASKIP,NORM),COLOR=GREEN,    X
               INITIAL='SOLDE                :'
SOLDE    DFHMDF POS=(8,26),LENGTH=18,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
         DFHMDF POS=(9,2),LENGTH=22,ATTRB=(ASKIP,NORM),COLOR=GREEN,    X
               INITIAL='DECOUVERT AUTORISE   :'
DECOUV   DFHMDF POS=(9,26),LENGTH=18,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
         DFHMDF POS=(10,2),LENGTH=22,ATTRB=(ASKIP,NORM),COLOR=GREEN,   X
               INITIAL='SOLDE DISPONIBLE     :'
DISPO    DFHMDF POS=(10,26),LENGTH=18,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
         DFHMDF POS=(12,2),LENGTH=22,ATTRB=(ASKIP,NORM),COLOR=GREEN,   X
               INITIAL='STATUT DU COMPTE     :'
STAT     DFHMDF POS=(12,26),LENGTH=10,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
         DFHMDF POS=(13,2),LENGTH=22,ATTRB=(ASKIP,NORM),COLOR=GREEN,   X
               INITIAL='DERNIERE MISE A JOUR :'
DTMAJ    DFHMDF POS=(13,26),LENGTH=10,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
* LIGNE 22 : MESSAGE / LIGNE 24 : TOUCHES DE FONCTION
MSG      DFHMDF POS=(22,2),LENGTH=78,ATTRB=(ASKIP,BRT),COLOR=GREEN
         DFHMDF POS=(24,2),LENGTH=40,ATTRB=(ASKIP,NORM),COLOR=BLUE,    X
               INITIAL='ENTREE=CONSULTER   PF3/CLEAR=QUITTER'
         DFHMSD TYPE=FINAL
         END
