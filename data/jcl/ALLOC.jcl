//ALLOC    JOB (ACCT),'ALLOCATION',CLASS=A,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID
//*--------------------------------------------------------------------
//* ALLOCATION DES BIBLIOTHEQUES ET FICHIERS D'ENTREE DU PROJET
//* (ALTERNATIVE A LA CREATION PAR ZOWE CLI). AUCUNE CLASSE SMS
//* N'EST IMPOSEE : LES ROUTINES ACS DU SITE CHOISISSENT.
//* LOAD ET DBRMLIB NE SONT PAS ALLOUES ICI (DEJA EXISTANTS).
//*--------------------------------------------------------------------
//STEP010  EXEC PGM=IEFBR14
//COBOL    DD DSN=&SYSUID..BANK.COBOL,DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,5,10)),
//            DCB=(DSORG=PO,RECFM=FB,LRECL=80,BLKSIZE=0)
//CPY      DD DSN=&SYSUID..BANK.CPY,DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,5,10)),
//            DCB=(DSORG=PO,RECFM=FB,LRECL=80,BLKSIZE=0)
//SEED     DD DSN=&SYSUID..BANK.SEED.COMPTES,DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1)),
//            DCB=(DSORG=PS,RECFM=FB,LRECL=80,BLKSIZE=0)
//MVTSIN   DD DSN=&SYSUID..BANK.MVTS.IN,DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1)),
//            DCB=(DSORG=PS,RECFM=FB,LRECL=80,BLKSIZE=0)
