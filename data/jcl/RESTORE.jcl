//RESTORE  JOB (ACCT),'RESTAURATION',CLASS=A,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID
//*--------------------------------------------------------------------
//* RESTAURATION DU FICHIER MAITRE DES COMPTES A PARTIR DE LA DERNIERE
//* SAUVEGARDE (GENERATION 0 DE LA GDG), AVANT RELANCE DE LA CHAINE
//* SUITE A UN INCIDENT EN STEP030.
//* LE KSDS ETANT DEFINI AVEC REUSE, IL EST VIDE PUIS RECHARGE.
//*--------------------------------------------------------------------
//STEP010  EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//BACKUP   DD DSN=&SYSUID..BANK.CPTMST.BKP(0),DISP=SHR
//CPTMST   DD DSN=&SYSUID..BANK.CPTMST,DISP=OLD
//SYSIN    DD *
  REPRO INFILE(BACKUP) OUTFILE(CPTMST) REUSE
/*
