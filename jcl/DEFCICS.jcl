//DEFCICS  JOB (ACCT),'DEFINITIONS CICS',CLASS=A,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID
//*--------------------------------------------------------------------
//* DEFINITIONS DES RESSOURCES CICS DES TRANSACTIONS BNKI ET BNKH
//* (UTILITAIRE BATCH DFHCSDUP), EQUIVALENT DES COMMANDES CEDA DEFINE.
//*
//* A LANCER REGION CICS ARRETEE (LE CSD EST ALORS LIBRE), PUIS
//* DEMARRER LA REGION ET FAIRE : CEDA INSTALL GROUP(BNKGRP)
//* REGION ACTIVE : UTILISER PLUTOT LES COMMANDES CEDA DU README.
//*
//* GROUPE BNKGRP : RESSOURCES DE L'APPLICATION
//*   BNKI (CONSULTATION) : PROGRAM BNKCON01, MAPSET BNKMS01
//*   BNKH (HISTORIQUE)   : PROGRAM BNKHIS01, MAPSET BNKMS02
//*   FILE CPTMST         : KSDS DES COMPTES (LECTURE)
//*   FILE MVTHIST        : KSDS DE L'HISTORIQUE (LECTURE + BROWSE),
//*                         EXTRAIT DE DB2 PAR LE JOB EXTHIST
//* LES FICHIERS SONT EN LECTURE SEULE : LES MISES A JOUR RESTENT AU
//* BATCH.
//* POUR RELANCER CE JOB, AJOUTER EN TETE DU SYSIN :
//*   DELETE GROUP(BNKGRP)
//*
//* SI TON SYSTEME NE SUBSTITUE PAS &SYSUID DANS LES DONNEES
//* IN-STREAM, REMPLACE-LE PAR TON IDENTIFIANT.
//*--------------------------------------------------------------------
//         SET CICSHLQ=DFH620.CICS
//*
//CSDUP    EXEC PGM=DFHCSDUP
//STEPLIB  DD DSN=&CICSHLQ..SDFHLOAD,DISP=SHR
//DFHCSD   DD DSN=&SYSUID..CICS.DFHCSD,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *,SYMBOLS=JCLONLY
  DEFINE PROGRAM(BNKCON01) GROUP(BNKGRP) LANGUAGE(COBOL)
         DESCRIPTION(CONSULTATION DE COMPTE)
  DEFINE MAPSET(BNKMS01) GROUP(BNKGRP)
         DESCRIPTION(ECRAN DE CONSULTATION DE COMPTE)
  DEFINE TRANSACTION(BNKI) GROUP(BNKGRP) PROGRAM(BNKCON01)
         DESCRIPTION(CONSULTATION DE COMPTE)
  DEFINE FILE(CPTMST) GROUP(BNKGRP)
         DSNAME(&SYSUID..BANK.CPTMST)
         RECORDFORMAT(F) STATUS(ENABLED) OPENTIME(FIRSTREF)
         READ(YES) BROWSE(NO) ADD(NO) UPDATE(NO) DELETE(NO)
         DESCRIPTION(FICHIER DES COMPTES EN LECTURE SEULE)
  DEFINE PROGRAM(BNKHIS01) GROUP(BNKGRP) LANGUAGE(COBOL)
         DESCRIPTION(HISTORIQUE DES MOUVEMENTS)
  DEFINE MAPSET(BNKMS02) GROUP(BNKGRP)
         DESCRIPTION(ECRAN HISTORIQUE DES MOUVEMENTS)
  DEFINE TRANSACTION(BNKH) GROUP(BNKGRP) PROGRAM(BNKHIS01)
         DESCRIPTION(HISTORIQUE DES MOUVEMENTS)
  DEFINE FILE(MVTHIST) GROUP(BNKGRP)
         DSNAME(&SYSUID..BANK.MVTHIST)
         RECORDFORMAT(F) STATUS(ENABLED) OPENTIME(FIRSTREF)
         READ(YES) BROWSE(YES) ADD(NO) UPDATE(NO) DELETE(NO)
         DESCRIPTION(HISTORIQUE DES MOUVEMENTS EN LECTURE SEULE)
  LIST GROUP(BNKGRP) OBJECTS
/*
