//EXTHIST  JOB (ACCT),'EXTRACTION HISTO',CLASS=A,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID
//*--------------------------------------------------------------------
//* EXTRACTION DE L'HISTORIQUE DB2 VERS LE KSDS LU PAR CICS (BNKH)
//*
//* LA REGION CICS N'EST PAS CONNECTEE A DB2 (PAS DE DB2CONN, ET LA
//* CONFIGURATION DE LA REGION EST GEREE PAR LE SYSTEME) : LE
//* TRANSACTIONNEL CONSULTE DONC UNE COPIE VSAM DE L'HISTORIQUE,
//* RAFRAICHIE PAR CE JOB. EN PRODUCTION, CE SERAIT UN STEP DE LA
//* CHAINE BATCH, APRES LE CHARGEMENT DB2 (STEP040).
//*
//* AVANT : CEMT SET FILE(MVTHIST) CLOSED DISABLED  (SI DEJA DEFINI)
//* APRES : CEMT SET FILE(MVTHIST) ENABLED
//*
//* STEP010 : IDCAMS - SUPPRESSION PUIS DEFINITION DU KSDS
//*           CLE = COMPTE (11) + DATE INVERSEE (8) + REFERENCE (12)
//* STEP020 : BNKEXT01 SOUS IKJEFT01 - LECTURE DB2, ECRITURE DU KSDS
//*--------------------------------------------------------------------
//         EXPORT SYMLIST=*
//         SET DB2HLQ=DSND10
//         SET SSID=DBDG
//*
//STEP010  EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *,SYMBOLS=JCLONLY
  DELETE &SYSUID..BANK.MVTHIST CLUSTER PURGE
  SET MAXCC = 0
  DEFINE CLUSTER (NAME(&SYSUID..BANK.MVTHIST)     -
                  INDEXED                         -
                  KEYS(31 0)                      -
                  RECORDSIZE(80 80)               -
                  FREESPACE(10 10)                -
                  SHAREOPTIONS(2 3)               -
                  REUSE                           -
                  TRACKS(2 2))                    -
         DATA    (NAME(&SYSUID..BANK.MVTHIST.DATA) -
                  CONTROLINTERVALSIZE(4096))      -
         INDEX   (NAME(&SYSUID..BANK.MVTHIST.INDEX))
/*
//*--------------------------------------------------------------------
//STEP020  EXEC PGM=IKJEFT01,DYNAMNBR=20,COND=(0,NE,STEP010)
//STEPLIB  DD DSN=&DB2HLQ..SDSNLOAD,DISP=SHR
//MVTHIST  DD DSN=&SYSUID..BANK.MVTHIST,DISP=OLD
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSTSIN  DD *,SYMBOLS=JCLONLY
  DSN SYSTEM(&SSID)
  RUN PROGRAM(BNKEXT01) PLAN(&SYSUID) LIB('&SYSUID..LOAD')
  END
/*
