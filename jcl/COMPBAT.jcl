//COMPBAT  JOB (ACCT),'COMPILE BATCH',CLASS=A,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID
//*--------------------------------------------------------------------
//* COMPILATION ET EDITION DE LIENS DES PROGRAMMES BATCH (SANS DB2)
//* PROCEDURE IBM STANDARD IGYWCL (ENTERPRISE COBOL)
//*
//* SOURCES    : &SYSUID..BANK.COBOL   (PDS FB 80)
//* COPYBOOKS  : &SYSUID..BANK.CPY     (PDS FB 80)
//* LOAD       : &SYSUID..LOAD
//*--------------------------------------------------------------------
//CINI01   EXEC IGYWCL
//COBOL.SYSIN  DD DSN=&SYSUID..BANK.COBOL(BNKINI01),DISP=SHR
//COBOL.SYSLIB DD DSN=&SYSUID..BANK.CPY,DISP=SHR
//LKED.SYSLMOD DD DSN=&SYSUID..LOAD(BNKINI01),DISP=SHR
//*
//CVAL01   EXEC IGYWCL
//COBOL.SYSIN  DD DSN=&SYSUID..BANK.COBOL(BNKVAL01),DISP=SHR
//COBOL.SYSLIB DD DSN=&SYSUID..BANK.CPY,DISP=SHR
//LKED.SYSLMOD DD DSN=&SYSUID..LOAD(BNKVAL01),DISP=SHR
//*
//CMAJ01   EXEC IGYWCL
//COBOL.SYSIN  DD DSN=&SYSUID..BANK.COBOL(BNKMAJ01),DISP=SHR
//COBOL.SYSLIB DD DSN=&SYSUID..BANK.CPY,DISP=SHR
//LKED.SYSLMOD DD DSN=&SYSUID..LOAD(BNKMAJ01),DISP=SHR
