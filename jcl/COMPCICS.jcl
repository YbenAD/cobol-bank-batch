//COMPCICS JOB (ACCT),'COMPILE CICS',CLASS=A,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID,REGION=0M
//*--------------------------------------------------------------------
//* COMPILATION D'UN PROGRAMME CICS
//*
//* PROG : PROGRAMME A COMPILER
//*          BNKCON01 = TRANSACTION BNKI (CONSULTATION DE COMPTE)
//*          BNKHIS01 = TRANSACTION BNKH (HISTORIQUE DES MOUVEMENTS)
//*
//* PROCEDURE IBM DFHZITCL : ENTERPRISE COBOL AVEC LE TRADUCTEUR CICS
//* INTEGRE (LES EXEC CICS SONT TRAITES PAR LE COMPILATEUR), PUIS
//* EDITION DE LIENS DANS LA BIBLIOTHEQUE DE LA REGION (DFHRPL).
//* MEME METHODE QUE LE JCL DFHCOBCL DU CHALLENGE CICS HELLO WORLD.
//*
//* PREREQUIS : JOB COMPBMS EXECUTE POUR L'ECRAN DU PROGRAMME
//* (COPYBOOK BNKMS01 OU BNKMS02 DANS BANK.CPY).
//*
//* COBOL.SYSLIB : BANK.CPY (CPYCPT, CPYHIS, BNKMS0X) REMPLACE LE
//* PREMIER DD DE LA PROCEDURE ; LES SUIVANTS (SDFHCOB : DFHAID,
//* DFHBMSCA) SONT CONSERVES.
//*
//* APRES CHAQUE RECOMPILATION, DANS CICS : CEMT SET PROGRAM(<PROG>)
//* NEWCOPY (SINON CICS GARDE L'ANCIENNE VERSION EN MEMOIRE).
//*--------------------------------------------------------------------
//         EXPORT SYMLIST=*
//         SET PROG=BNKHIS01
//*
//CICSPROG EXEC DFHZITCL
//COBOL.SYSIN  DD DISP=SHR,DSN=&SYSUID..BANK.COBOL(&PROG)
//COBOL.SYSLIB DD DISP=SHR,DSN=&SYSUID..BANK.CPY
//LKED.SYSLMOD DD DISP=SHR,DSN=&SYSUID..CICS.PROD.DFHLOAD
//LKED.SYSIN   DD *,SYMBOLS=JCLONLY
  NAME &PROG(R)
/*
