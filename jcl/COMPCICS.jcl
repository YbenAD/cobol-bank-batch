//COMPCICS JOB (ACCT),'COMPILE CICS',CLASS=A,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID,REGION=0M
//*--------------------------------------------------------------------
//* COMPILATION DU PROGRAMME CICS BNKCON01 (TRANSACTION BNKI)
//*
//* PROCEDURE IBM DFHZITCL : ENTERPRISE COBOL AVEC LE TRADUCTEUR CICS
//* INTEGRE (LES EXEC CICS SONT TRAITES PAR LE COMPILATEUR), PUIS
//* EDITION DE LIENS DANS LA BIBLIOTHEQUE DE LA REGION (DFHRPL).
//* MEME METHODE QUE LE JCL DFHCOBCL DU CHALLENGE CICS HELLO WORLD.
//*
//* PREREQUIS : JOB COMPBMS EXECUTE (COPYBOOK BNKMS01 DANS BANK.CPY).
//*
//* COBOL.SYSLIB : BANK.CPY (CPYCPT, BNKMS01) REMPLACE LE PREMIER DD
//* DE LA PROCEDURE ; LES SUIVANTS (SDFHCOB : DFHAID, DFHBMSCA) SONT
//* CONSERVES.
//*
//* APRES CHAQUE RECOMPILATION, DANS CICS : CEMT SET PROGRAM(BNKCON01)
//* NEWCOPY (SINON CICS GARDE L'ANCIENNE VERSION EN MEMOIRE).
//*--------------------------------------------------------------------
//CICSPROG EXEC DFHZITCL
//COBOL.SYSIN  DD DISP=SHR,DSN=&SYSUID..BANK.COBOL(BNKCON01)
//COBOL.SYSLIB DD DISP=SHR,DSN=&SYSUID..BANK.CPY
//LKED.SYSLMOD DD DISP=SHR,DSN=&SYSUID..CICS.PROD.DFHLOAD
//LKED.SYSIN   DD *
  NAME BNKCON01(R)
/*
