//BNKCHAIN JOB (ACCT),'BATCH BANCAIRE',CLASS=A,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID
//*====================================================================
//* CHAINE BATCH QUOTIDIENNE DE TRAITEMENT DES MOUVEMENTS BANCAIRES
//*
//* STEP005  IEFBR14  SUPPRESSION DES FICHIERS DU RUN PRECEDENT
//* STEP010  BNKVAL01 VALIDATION DES MOUVEMENTS          RC 0 OU 4
//* STEP020  SORT     TRI PAR COMPTE / DATE / TYPE / REFERENCE
//* STEP025  IDCAMS   SAUVEGARDE DU KSDS DANS LA GDG (+1)
//* STEP030  BNKMAJ01 MISE A JOUR DES COMPTES            RC 0 OU 4
//* STEP040  BNKDB201 CHARGEMENT DE L'HISTORIQUE DB2     RC 0 OU 4
//*
//* REPRISE : SI STEP030 EST EN ERREUR, LANCER RESTORE PUIS RELANCER
//*           LA CHAINE. SI SEUL STEP040 EST EN ERREUR, IL PEUT ETRE
//*           RELANCE SEUL (RESTART=STEP040) : LES MOUVEMENTS DEJA
//*           CHARGES SONT IGNORES (SQLCODE -803).
//*
//* LES DEUX SYNTAXES DE CONDITIONNEMENT SONT UTILISEES : COND= POUR
//* STEP020 A STEP030, IF/THEN/ENDIF POUR STEP040.
//*====================================================================
//         SET DB2HLQ=DSNC10
//         SET SSID=DBCG
//*--------------------------------------------------------------------
//* STEP005 : NETTOYAGE (MOD,DELETE NE PLANTE PAS SI ABSENT)
//*--------------------------------------------------------------------
//STEP005  EXEC PGM=IEFBR14
//DEL1     DD DSN=&SYSUID..BANK.MVTVALID,DISP=(MOD,DELETE,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(1,1))
//DEL2     DD DSN=&SYSUID..BANK.MVTREJ1,DISP=(MOD,DELETE,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(1,1))
//DEL3     DD DSN=&SYSUID..BANK.MVTTRI,DISP=(MOD,DELETE,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(1,1))
//DEL4     DD DSN=&SYSUID..BANK.MVTAPP,DISP=(MOD,DELETE,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(1,1))
//DEL5     DD DSN=&SYSUID..BANK.MVTREJ2,DISP=(MOD,DELETE,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(1,1))
//*--------------------------------------------------------------------
//* STEP010 : VALIDATION DES MOUVEMENTS
//*--------------------------------------------------------------------
//STEP010  EXEC PGM=BNKVAL01
//STEPLIB  DD DSN=&SYSUID..LOAD,DISP=SHR
//MVTIN    DD DSN=&SYSUID..BANK.MVTS.IN,DISP=SHR
//MVTOK    DD DSN=&SYSUID..BANK.MVTVALID,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//MVTREJ   DD DSN=&SYSUID..BANK.MVTREJ1,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=120,BLKSIZE=0)
//SYSOUT   DD SYSOUT=*
//SYSIN    DD *
20261101
/*
//*--------------------------------------------------------------------
//* STEP020 : TRI DES MOUVEMENTS VALIDES
//*   13,11 NUMERO DE COMPTE   36,8 DATE   24,1 TYPE (C AVANT D)
//*   1,12  REFERENCE
//*   LES CREDITS SONT APPLIQUES AVANT LES DEBITS D'UNE MEME JOURNEE
//*   (CHOIX METIER FAVORABLE AU CLIENT POUR LE CONTROLE DU DECOUVERT)
//*--------------------------------------------------------------------
//STEP020  EXEC PGM=SORT,COND=(4,LT,STEP010)
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=&SYSUID..BANK.MVTVALID,DISP=SHR
//SORTOUT  DD DSN=&SYSUID..BANK.MVTTRI,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//SYSIN    DD *
  SORT FIELDS=(13,11,CH,A,36,8,CH,A,24,1,CH,A,1,12,CH,A)
/*
//*--------------------------------------------------------------------
//* STEP025 : SAUVEGARDE DU FICHIER MAITRE AVANT MISE A JOUR
//*--------------------------------------------------------------------
//STEP025  EXEC PGM=IDCAMS,COND=((4,LT,STEP010),(0,NE,STEP020))
//SYSPRINT DD SYSOUT=*
//CPTMST   DD DSN=&SYSUID..BANK.CPTMST,DISP=SHR
//BACKUP   DD DSN=&SYSUID..BANK.CPTMST.BKP(+1),
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(1,1),RLSE),
//            DCB=(RECFM=FB,LRECL=100,BLKSIZE=0)
//SYSIN    DD *
  REPRO INFILE(CPTMST) OUTFILE(BACKUP)
/*
//*--------------------------------------------------------------------
//* STEP030 : MISE A JOUR DES COMPTES
//*--------------------------------------------------------------------
//STEP030  EXEC PGM=BNKMAJ01,
//             COND=((4,LT,STEP010),(0,NE,STEP020),(0,NE,STEP025))
//STEPLIB  DD DSN=&SYSUID..LOAD,DISP=SHR
//MVTTRI   DD DSN=&SYSUID..BANK.MVTTRI,DISP=SHR
//CPTMST   DD DSN=&SYSUID..BANK.CPTMST,DISP=OLD
//MVTAPP   DD DSN=&SYSUID..BANK.MVTAPP,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//MVTREJ   DD DSN=&SYSUID..BANK.MVTREJ2,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=120,BLKSIZE=0)
//RAPPORT  DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSIN    DD *
20261101
/*
//*--------------------------------------------------------------------
//* STEP040 : CHARGEMENT DE L'HISTORIQUE DB2
//*   EXECUTE SEULEMENT SI STEP030 A TOURNE ET A RENDU RC <= 4
//*--------------------------------------------------------------------
//         IF (STEP030.RUN AND STEP030.RC <= 4) THEN
//STEP040  EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD DSN=&DB2HLQ..SDSNLOAD,DISP=SHR
//MVTAPP   DD DSN=&SYSUID..BANK.MVTAPP,DISP=SHR
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSTSIN  DD *,SYMBOLS=JCLONLY
  DSN SYSTEM(&SSID)
  RUN PROGRAM(BNKDB201) PLAN(BNKPLAN) LIB('&SYSUID..LOAD')
  END
/*
//         ENDIF
