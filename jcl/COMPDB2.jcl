//COMPDB2  JOB (ACCT),'COMPILE DB2',CLASS=A,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID
//*--------------------------------------------------------------------
//* COMPILATION DE BNKDB201 AVEC LE COPROCESSEUR DB2 (OPTION SQL),
//* PUIS BIND DU PLAN.
//*
//* A ADAPTER A TON SITE (SUR IBM Z XPLORE, RECOPIE LES VALEURS DES
//* JCL FOURNIS DANS LES CHALLENGES DB2) :
//*   DB2HLQ : QUALIFIANT DE LA BIBLIOTHEQUE DB2 SDSNLOAD
//*   SSID   : SOUS-SYSTEME DB2
//* PREREQUIS : PDS &SYSUID..DBRMLIB (FB 80) ALLOUE, TABLE MVT_HIST
//* CREEE.
//* SUR IBM Z XPLORE, LE COMPTE ETUDIANT N'A PAS LE PRIVILEGE BINDADD
//* (BIND PACKAGE REFUSE) : LE DBRM EST DONC LIE DIRECTEMENT DANS LE
//* PLAN QUI PORTE TON ID (MEMBER), COMME DANS LES JCL DU COURS. DB2
//* CREE LUI-MEME LE PACKAGE CORRESPONDANT. EN ENTREPRISE, ON FERAIT
//* UN BIND PACKAGE DANS UNE COLLECTION, PUIS UN BIND PLAN PKLIST.
//*--------------------------------------------------------------------
//* EXPORT : REND LES SYMBOLES SET UTILISABLES DANS LES CARTES
//* IN-STREAM (SYSTSIN DD *,SYMBOLS=JCLONLY)
//         EXPORT SYMLIST=*
//         SET DB2HLQ=DSND10
//         SET SSID=DBDG
//*
//COMPILE  EXEC IGYWCL,PARM.COBOL='SQL'
//* LE DD SANS OPERANDE CONSERVE LA BIBLIOTHEQUE DU COMPILATEUR,
//* LE SUIVANT AJOUTE SDSNLOAD A LA CONCATENATION
//COBOL.STEPLIB DD
//              DD DSN=&DB2HLQ..SDSNLOAD,DISP=SHR
//COBOL.SYSIN   DD DSN=&SYSUID..BANK.COBOL(BNKDB201),DISP=SHR
//COBOL.SYSLIB  DD DSN=&SYSUID..BANK.CPY,DISP=SHR
//COBOL.DBRMLIB DD DSN=&SYSUID..DBRMLIB(BNKDB201),DISP=SHR
//* SYSLIB DE L'EDITION DE LIENS : LANGUAGE ENVIRONMENT (ROUTINES
//* CEE*/IGZ* DU RUNTIME COBOL) PUIS DB2 (DSNELI, DSNTIAR)
//LKED.SYSLIB   DD DSN=CEE.SCEELKED,DISP=SHR
//              DD DSN=&DB2HLQ..SDSNLOAD,DISP=SHR
//LKED.SYSLMOD  DD DSN=&SYSUID..LOAD(BNKDB201),DISP=SHR
//LKED.SYSIN    DD *
  INCLUDE SYSLIB(DSNELI)
/*
//*--------------------------------------------------------------------
//BIND     EXEC PGM=IKJEFT01,COND=(4,LT)
//STEPLIB  DD DSN=&DB2HLQ..SDSNLOAD,DISP=SHR
//DBRMLIB  DD DSN=&SYSUID..DBRMLIB,DISP=SHR
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSTSIN  DD *,SYMBOLS=JCLONLY
  DSN SYSTEM(&SSID)
  BIND PLAN(&SYSUID) PKLIST(&SYSUID..*) MEMBER(BNKDB201) -
       ACTION(REPLACE) ISOLATION(CS) ENCODING(EBCDIC)
  END
/*
