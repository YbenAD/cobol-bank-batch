//LOADDB2  JOB (ACCT),'RELANCE DB2',CLASS=A,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID
//*--------------------------------------------------------------------
//* RELANCE SEULE DU CHARGEMENT DB2 (EQUIVALENT DU STEP040 DE
//* BNKCHAIN), A PARTIR DU FICHIER MVTAPP PRODUIT PAR STEP030.
//* RELANCABLE : LES MOUVEMENTS DEJA CHARGES SONT IGNORES (-803).
//* ADAPTER DB2HLQ ET SSID COMME DANS BNKCHAIN.
//*--------------------------------------------------------------------
//* EXPORT : REND LES SYMBOLES SET UTILISABLES DANS LES CARTES
//* IN-STREAM (SYSTSIN DD *,SYMBOLS=JCLONLY)
//         EXPORT SYMLIST=*
//         SET DB2HLQ=DSND10
//         SET SSID=DBDG
//*
//STEP040  EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD DSN=&DB2HLQ..SDSNLOAD,DISP=SHR
//MVTAPP   DD DSN=&SYSUID..BANK.MVTAPP,DISP=SHR
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSTSIN  DD *,SYMBOLS=JCLONLY
  DSN SYSTEM(&SSID)
  RUN PROGRAM(BNKDB201) PLAN(&SYSUID) LIB('&SYSUID..LOAD')
  END
/*
