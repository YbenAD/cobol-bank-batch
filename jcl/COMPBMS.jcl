//COMPBMS  JOB (ACCT),'ASSEMBLAGE BMS',CLASS=A,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID
//*--------------------------------------------------------------------
//* ASSEMBLAGE DU MAPSET BMS BNKMS01 (ECRAN DE LA TRANSACTION BNKI)
//*
//* UN MAPSET S'ASSEMBLE DEUX FOIS A PARTIR DU MEME SOURCE :
//*   ASMMAP/LINKMAP : SYSPARM(MAP)   -> MAP PHYSIQUE (MODULE CHARGE
//*                    PAR CICS) DANS &SYSUID..CICS.PROD.DFHLOAD
//*   ASMDSECT       : SYSPARM(DSECT) -> MAP SYMBOLIQUE (COPYBOOK
//*                    COBOL) DANS &SYSUID..BANK.CPY(BNKMS01)
//* C'EST CE QUE FAIT LA PROCEDURE IBM DFHMAPS, ECRIT ICI EN CLAIR.
//*
//* SOURCE : &SYSUID..BANK.BMS(BNKMS01)  (PDS FB 80)
//* CICSHLQ : PREFIXE DES BIBLIOTHEQUES CICS (DFH620.CICS SUR Z XPLORE,
//*           VOIR CEMT INQUIRE LIBRARY)
//*--------------------------------------------------------------------
//         SET CICSHLQ=DFH620.CICS
//*
//* 1. MAP PHYSIQUE : L'ASSEMBLEUR PRODUIT L'OBJET SUR SYSPUNCH (DECK)
//ASMMAP   EXEC PGM=ASMA90,PARM='SYSPARM(MAP),DECK,NOOBJECT'
//SYSLIB   DD DSN=&CICSHLQ..SDFHMAC,DISP=SHR
//         DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(5,5))
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DSN=&&MAP,DISP=(NEW,PASS,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(5,5)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=400)
//SYSIN    DD DSN=&SYSUID..BANK.BMS(BNKMS01),DISP=SHR
//*
//* 2. EDITION DE LIENS DE LA MAP PHYSIQUE DANS LA BIBLIOTHEQUE CICS
//LINKMAP  EXEC PGM=IEWL,PARM='LIST,LET,XREF',COND=(4,LT,ASMMAP)
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD UNIT=SYSDA,SPACE=(TRK,(5,5))
//SYSLMOD  DD DSN=&SYSUID..CICS.PROD.DFHLOAD(BNKMS01),DISP=SHR
//SYSLIN   DD DSN=&&MAP,DISP=(OLD,DELETE)
//*
//* 3. MAP SYMBOLIQUE : COPYBOOK COBOL ECRIT DIRECTEMENT DANS BANK.CPY
//ASMDSECT EXEC PGM=ASMA90,PARM='SYSPARM(DSECT),DECK,NOOBJECT',
//             COND=(4,LT,ASMMAP)
//SYSLIB   DD DSN=&CICSHLQ..SDFHMAC,DISP=SHR
//         DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(5,5))
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DSN=&SYSUID..BANK.CPY(BNKMS01),DISP=SHR
//SYSIN    DD DSN=&SYSUID..BANK.BMS(BNKMS01),DISP=SHR
